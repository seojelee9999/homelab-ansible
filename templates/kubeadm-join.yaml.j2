---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ kubernetes_api_endpoint | to_json }}
    token: {{ worker_join_token.stdout | trim | to_json }}
    caCertHashes:
      - {{ ('sha256:' + control_plane_ca_hash.stdout | trim) | to_json }}
nodeRegistration:
  name: {{ kubernetes_node_name | to_json }}
  criSocket: {{ kubernetes_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubernetes_node_ip | to_json }}
