---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ kubernetes_node_ip | to_json }}
  bindPort: 6443
nodeRegistration:
  name: {{ kubernetes_node_name | to_json }}
  criSocket: {{ kubernetes_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubernetes_node_ip | to_json }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ installed_kubeadm_version.stdout | trim | to_json }}
controlPlaneEndpoint: {{ kubernetes_api_endpoint | to_json }}
networking:
  podSubnet: {{ kubernetes_pod_subnet | to_json }}
  serviceSubnet: {{ kubernetes_service_subnet | to_json }}
  dnsDomain: {{ kubernetes_dns_domain | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
